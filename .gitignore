# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
*.tsbuildinfo

# Environment - only the .example files are ever committed
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# Caches
.vite/
.cache/
.npm
.eslintcache
coverage/

# Python bytecode (infrastructure/lab function sources)
__pycache__/
*.py[cod]

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp

# Credentials - belt and braces. Nothing of this shape should ever be committed.
.aws/
*.pem
*.key
credentials

# Local plan storage (not AWS, not a database)
backend/.data/

# Demo video intermediates - 185 capture frames, ~31MB, regenerable with
# demo/scripts/capture3.mjs. The rendered video and the scripts that build it are
# committed; the frames they were built from are not.
demo/raw/
