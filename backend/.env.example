# Copy to .env for local development. Never commit the real .env.
#
# Credentials are deliberately absent. The AWS SDK resolves them at runtime from
# the standard provider chain (shared config, environment, or an IAM role), so no
# access keys are ever read from this file or checked into the repository.

NODE_ENV=development
PORT=4000
HOST=127.0.0.1

# Region the lab environment lives in.
AWS_REGION=us-east-1

# Comma-separated list of browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:5180,http://localhost:4180

LOG_LEVEL=info

# --- Remediation plan store -----------------------------------------------
# Deployed, this names a DynamoDB table so an approval and its verification result
# survive a Lambda container being recycled. Left unset - as here - plans fall back
# to a JSON file under backend/.data/, so local development needs no AWS resource.
# REMEDIATION_TABLE_NAME=aicoe-remediation-plans

# --- Amazon Bedrock -------------------------------------------------------
# Model availability and access differ per account, per model and per region.
# Verify with a real Converse call before changing these:
#   aws bedrock-runtime converse --model-id <id> --region us-east-1 \
#     --messages '[{"role":"user","content":[{"text":"hi"}]}]' \
#     --inference-config '{"maxTokens":64}'
#
# Measured in this account on 2026-09-30, 3 attempts each:
#   us.amazon.nova-pro-v1:0                       3/3  <- default
#   us.amazon.nova-lite-v1:0                      3/3
#   us.anthropic.claude-haiku-4-5-20251001-v1:0   0/3  INVALID_PAYMENT_INSTRUMENT
#   us.anthropic.claude-sonnet-4-6                0/3  INVALID_PAYMENT_INSTRUMENT
#   us.anthropic.claude-sonnet-4-5-20250929-v1:0  0/3  INVALID_PAYMENT_INSTRUMENT
#
# Every Anthropic model is blocked by an AWS Marketplace subscription this account
# cannot complete - not by a missing IAM permission. Once that is resolved, switching
# to Claude is a one-line change here; no code refers to a model id directly.
#
# Note: no Anthropic model supports direct on-demand invocation in us-east-1. They are
# only reachable through an inference profile, hence the "us." prefix.
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0
BEDROCK_FALLBACK_MODEL_IDS=us.amazon.nova-lite-v1:0,us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_REGION=us-east-1
BEDROCK_MAX_TOKENS=4096
BEDROCK_CACHE_TTL_SECONDS=600
BEDROCK_MIN_INTERVAL_SECONDS=20
