# Copy to .env for local development. Never commit the real .env.
#
# Credentials are deliberately absent. The AWS SDK resolves them at runtime from
# the standard provider chain (shared config, environment, or an IAM role), so no
# access keys are ever read from this file or checked into the repository.

NODE_ENV=development
PORT=4000
HOST=127.0.0.1

# Region the lab environment lives in.
AWS_REGION=us-east-1

# Comma-separated list of browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:5180,http://localhost:4180

LOG_LEVEL=info
