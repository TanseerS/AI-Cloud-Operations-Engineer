# Copy to .env.local for local development.
#
# Only VITE_-prefixed values are bundled into the browser. Never put AWS credentials
# or any other secret here - everything in this file is public once the app ships.

# Local development against a backend running on this machine:
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Production: the deployed API Gateway endpoint. Set this in the build environment
# (for example an Amplify environment variable) rather than committing a .env file,
# so the same source builds for any environment.
#
#   VITE_API_BASE_URL=https://fo7occiuh3.execute-api.us-east-1.amazonaws.com/api/v1
#
# A production build must never ship a localhost URL.

VITE_APP_ENV=development
