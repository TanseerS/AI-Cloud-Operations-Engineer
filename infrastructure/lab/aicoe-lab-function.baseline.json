      "status": "active",
      "category": "cost-efficiency",
      "resource_type": "aws_lambda_function",
      "resource_name": "aicoe-lab-function",
      "attribute": "MemorySize",
      "intended_value": 128,
      "broken_value": 3008,
      "unit": "MB",
      "severity": "medium",
      "title": "Lambda memory is over-provisioned by 23.5x",
      "description": "The function is a constant-time handler returning a static dict, but it is configured with 3008 MB of memory. Actual usage is expected to stay near the 128 MB floor, so every millisecond of duration is billed at roughly 23.5x the necessary GB-second rate with no latency benefit.",
      "detection_hint": "Compare the CloudWatch Logs REPORT line 'Max Memory Used' against the configured 'Memory Size' for this function, or read MemorySize from lambda:GetFunctionConfiguration. A utilisation ratio far below 50% indicates over-provisioning.",
      "remediation": {
        "api": "lambda:UpdateFunctionConfiguration",
        "parameters": {
          "FunctionName": "aicoe-lab-function",
          "MemorySize": 128
        },
        "verification": "GetFunctionConfiguration returns MemorySize == 128 and the function still returns the expected response."
      },
      "reset": {
        "description": "Re-introduce the intentional issue for a fresh lab run.",
        "api": "lambda:UpdateFunctionConfiguration",
        "parameters": {
          "FunctionName": "aicoe-lab-function",
          "MemorySize": 3008
        },
        "verification": "GetFunctionConfiguration returns MemorySize == 3008."
      }
    }
