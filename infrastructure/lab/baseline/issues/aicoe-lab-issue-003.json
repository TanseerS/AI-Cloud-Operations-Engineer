{
    "issue_id": "aicoe-lab-issue-003",
    "status": "active",
    "category": "reliability",
    "severity": "high",
    "title": "Error-producing Lambda: required configuration missing",
    "target": {
        "type": "aws_lambda_function",
        "name": "aicoe-lab-error-function",
        "attribute": "Environment.Variables"
    },
    "intended_value": {
        "DOWNSTREAM_ENDPOINT": "https://example.invalid/aicoe-lab",
        "DOWNSTREAM_API_KEY": "lab-placeholder-not-a-real-secret"
    },
    "broken_value": {},
    "description": "aicoe-lab-error-function requires DOWNSTREAM_ENDPOINT and DOWNSTREAM_API_KEY. Neither is set, so every invocation logs a structured configuration_error and raises ConfigurationError. Deterministic 100% error rate.",
    "detection": {
        "primary": "lambda:Invoke -> FunctionError == 'Unhandled'",
        "secondary": "CloudWatch Logs JSON line event=configuration_error with missing_environment_variables",
        "metric": "AWS/Lambda Errors equals Invocations for this function",
        "signal": "every invocation fails with ConfigurationError"
    },
    "remediation": {
        "api": "lambda:UpdateFunctionConfiguration",
        "parameters": {
            "FunctionName": "aicoe-lab-error-function",
            "Environment": {
                "Variables": {
                    "DOWNSTREAM_ENDPOINT": "https://example.invalid/aicoe-lab",
                    "DOWNSTREAM_API_KEY": "lab-placeholder-not-a-real-secret"
                }
            }
        },
        "verification": "Invoke returns statusCode 200 and no FunctionError"
    },
    "reset": {
        "api": "lambda:UpdateFunctionConfiguration",
        "parameters": {
            "FunctionName": "aicoe-lab-error-function",
            "Environment": {
                "Variables": {}
            }
        },
        "verification": "Invoke returns FunctionError == 'Unhandled'"
    }
}
